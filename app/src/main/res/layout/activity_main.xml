<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    ==================
    Full-screen camera layout with:
      - PreviewView (camera feed)
      - CameraOverlayView (landmark drawings + border)
      - Raw gloss string display (bottom)
      - Final LLM-smoothed sentence (top card)
      - Status badge
      - Floating Clear button
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- =====================================================
         LAYER 1: Full-screen Camera Preview
         ===================================================== -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- =====================================================
         LAYER 2: Custom Overlay (Landmarks + Animated Border)
         Draw on top of the camera feed
         ===================================================== -->
    <com.isl.signbridge.ui.CameraOverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- =====================================================
         LAYER 3: Top Status Card (State + Final Sentence)
         ===================================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#CC000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- State Badge Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Animated status dot -->
                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_dot"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● LISTENING"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    tools:text="● LISTENING" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- LLM API Activity Indicator -->
                <ProgressBar
                    android:id="@+id/apiProgressBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="#2196F3"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- App Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SignBridge ISL"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:alpha="0.5"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <!-- Final Smoothed Sentence (LLM output) -->
            <TextView
                android:id="@+id/tvFinalSentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Translation will appear here..."
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-light"
                android:lineSpacingMultiplier="1.3"
                android:minHeight="52dp"
                android:gravity="start|center_vertical"
                tools:text="I need to go to the hospital." />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- =====================================================
         LAYER 4: Bottom Panel (Raw Gloss + Controls)
         ===================================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAW GLOSS"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:layout_marginBottom="6dp" />

            <!-- Raw sign gloss string building in real time -->
            <TextView
                android:id="@+id/tvRawGloss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:minHeight="32dp"
                android:gravity="start|center_vertical"
                tools:text="I HOSPITAL GO" />

            <!-- Hint for spell mode -->
            <TextView
                android:id="@+id/tvSpellHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spell mode active — swipe right wrist to confirm word"
                android:textColor="#FFAB40"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                tools:text="Spell mode active — swipe right wrist to confirm word" />

            <!-- Bottom controls row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="12dp">

                <!-- Word count chip -->
                <TextView
                    android:id="@+id/tvWordCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 words"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    tools:text="3 words" />

                <!-- Clear floating button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Clear"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="#FF4444"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
